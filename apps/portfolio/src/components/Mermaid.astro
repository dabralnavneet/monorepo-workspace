---
interface Props {
  chart: string;
  // Maps a subgraph id (e.g. "Region") to a border/fill color — mermaid's own
  // classDef/style directives don't reliably reach cluster (subgraph) borders.
  clusterColors?: Record<string, { stroke: string; fill?: string; dashed?: boolean }>;
  // Maps a node/subgraph id to one or more icon data URIs, drawn as a badge
  // straddling the box's top-left corner (the AWS architecture-diagram convention).
  // Mermaid always centers label content, so this can't be done via the label text itself.
  nodeIcons?: Record<string, string[]>;
}

const { chart, clusterColors, nodeIcons } = Astro.props;
---

<pre
  class="mermaid not-prose my-8 rounded-xl border border-zinc-200 dark:border-zinc-900 bg-zinc-100/60 dark:bg-zinc-950/60 p-4"
  data-cluster-colors={clusterColors ? JSON.stringify(clusterColors) : undefined}
  data-node-icons={nodeIcons ? JSON.stringify(nodeIcons) : undefined}
>{chart}</pre>

<script>
  import mermaid from 'mermaid';

  const SVG_NS = 'http://www.w3.org/2000/svg';

  // The rendered SVG bakes the theme in, so on a light/dark switch every diagram
  // has to be rebuilt from its original graph definition — stash that here before
  // mermaid replaces the <pre>'s text content with markup.
  const SOURCES = new WeakMap<HTMLElement, string>();

  const isDarkNow = () => document.documentElement.classList.contains('dark');
  const dLen = (p: Element) => (p.getAttribute('d') || '').length;

  let running = false;
  let rerunForced = false;

  async function renderMermaidDiagrams(force = false) {
    if (running) {
      rerunForced = rerunForced || force;
      return;
    }
    running = true;
    try {
      const all = Array.from(document.querySelectorAll<HTMLElement>('.mermaid'));
      for (const pre of all) {
        if (!SOURCES.has(pre)) SOURCES.set(pre, pre.textContent ?? '');
      }

      // `force` (a theme switch) rebuilds every diagram; otherwise only the ones
      // a fresh `astro:page-load` hasn't drawn yet.
      const targets = force ? all : all.filter((pre) => !pre.hasAttribute('data-processed'));
      if (targets.length === 0) return;

      for (const pre of targets) {
        pre.innerHTML = SOURCES.get(pre) ?? pre.textContent ?? '';
        pre.removeAttribute('data-processed');
      }

      const isDark = isDarkNow();
      // 'handDrawn' uses rough.js under the hood for an Excalidraw-style sketchy look.
      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'default',
        look: 'handDrawn',
        // Transparent cluster fill avoids a heavy hachure background clashing with the page.
        themeVariables: { clusterBkg: 'transparent', clusterBorder: 'transparent', fontSize: '17px' },
        flowchart: { padding: 24, nodeSpacing: 45, rankSpacing: 55 },
      });

      await mermaid.run({ nodes: targets });

      targets.forEach((preEl) => patchDiagram(preEl, isDark));
    } finally {
      running = false;
      if (rerunForced) {
        rerunForced = false;
        void renderMermaidDiagrams(true);
      }
    }
  }

  function patchDiagram(preEl: HTMLElement, isDark: boolean) {
    const svg = preEl.querySelector('svg');
    if (!svg) return;

    // --- Nodes -------------------------------------------------------------
    // Each rough.js node is two <path>s: a long hachure "fill" path (its stroke
    // holds the intended fill colour) and a short outline path. The dense
    // hachure buries the label — especially over a dark page — so drop it and
    // give the outline a flat, low-opacity fill instead. Keeps the sketchy edge.
    svg.querySelectorAll<SVGGElement>('g.rough-node, g.node').forEach((node) => {
      const paths = Array.from(node.querySelectorAll('path')).sort((a, b) => dLen(b) - dLen(a));
      if (paths.length >= 2) {
        const [hachure, outline] = paths;
        const fill = hachure.getAttribute('stroke') || outline.getAttribute('stroke') || 'currentColor';
        hachure.style.display = 'none';
        outline.setAttribute('fill', fill);
        outline.setAttribute('fill-opacity', isDark ? '0.16' : '0.9');
        outline.setAttribute('stroke-width', '2');
      } else if (paths.length === 1) {
        paths[0].setAttribute('stroke-width', '2');
      }

      // On a dark page every label must read light, regardless of the dark text
      // colour a `classDef color:` may have set for the light theme.
      if (isDark) {
        node.querySelectorAll<HTMLElement>('.nodeLabel, .nodeLabel *').forEach((el) => {
          el.style.setProperty('color', '#e4e4e7', 'important');
        });
        node.querySelectorAll('text, tspan').forEach((el) => el.setAttribute('fill', '#e4e4e7'));
      }
    });

    // --- Edges -----------------------------------------------------------
    svg.querySelectorAll('.edgePath path, .flowchart-link').forEach((el) => {
      el.setAttribute('stroke-width', '2.5');
    });

    // --- Cluster (subgraph) borders ------------------------------------
    svg.querySelectorAll('g.cluster *').forEach((el) => {
      if (el.tagName === 'path' || el.tagName === 'rect') {
        el.setAttribute('stroke-width', '3');
        const stroke = el.getAttribute('stroke') ?? '';
        if (stroke.includes('1.5873015873%') || stroke === 'transparent' || stroke === '') {
          el.setAttribute('stroke', isDark ? 'rgba(228, 228, 231, 0.7)' : 'rgba(63, 63, 70, 0.7)');
        }
      }
    });

    // Per-subgraph border colors, keyed by mermaid's cluster group id suffix (e.g. "...-Region").
    const colors = preEl.dataset.clusterColors ? JSON.parse(preEl.dataset.clusterColors) : null;
    if (colors) {
      svg.querySelectorAll('g.cluster').forEach((cluster) => {
        const name = Object.keys(colors).find((key) => cluster.id.endsWith(`-${key}`));
        if (!name) return;
        const { stroke, fill, dashed } = colors[name];
        cluster.querySelectorAll('path, rect').forEach((shape) => {
          shape.setAttribute('stroke', stroke);
          if (fill) shape.setAttribute('fill', fill);
          if (dashed) shape.setAttribute('stroke-dasharray', '8 6');
        });
      });
    }

    // --- Icon badges straddling each box's top-left corner --------------
    const icons = preEl.dataset.nodeIcons ? JSON.parse(preEl.dataset.nodeIcons) : null;
    if (icons) {
      const viewBox = svg.viewBox.baseVal;
      const svgRect = svg.getBoundingClientRect();
      // getBBox() is in each element's own local (pre-transform) space, so it can't be used
      // directly — convert the group's on-screen position back into the SVG's viewBox space instead.
      const scaleX = viewBox.width / svgRect.width;
      const scaleY = viewBox.height / svgRect.height;

      const groups = Array.from(svg.querySelectorAll<SVGGElement>('g.node, g.rough-node, g.cluster'));
      Object.entries(icons).forEach(([id, uris]) => {
        // Regular nodes get an id like "...-flowchart-SUB1-0"; clusters get "...-Region" (no suffix).
        const group = groups.find((g) => g.id.includes(`-${id}-`) || g.id.endsWith(`-${id}`));
        if (!group) return;
        const groupRect = group.getBoundingClientRect();
        const x = viewBox.x + (groupRect.left - svgRect.left) * scaleX;
        const y = viewBox.y + (groupRect.top - svgRect.top) * scaleY;
        const size = 22;
        (uris as string[]).forEach((uri, i) => {
          const image = document.createElementNS(SVG_NS, 'image');
          image.setAttribute('href', uri);
          image.setAttribute('width', String(size));
          image.setAttribute('height', String(size));
          image.setAttribute('x', String(x - size / 2 + i * (size + 4)));
          image.setAttribute('y', String(y - size / 2));
          svg.appendChild(image);
        });
      });
    }
  }

  document.addEventListener('astro:page-load', () => void renderMermaidDiagrams(false));

  // Redraw when the site theme toggles — the SVG's colours are baked in at build.
  if (!(window as unknown as { __mermaidThemeWatch?: boolean }).__mermaidThemeWatch) {
    (window as unknown as { __mermaidThemeWatch?: boolean }).__mermaidThemeWatch = true;
    let wasDark = isDarkNow();
    new MutationObserver(() => {
      const dark = isDarkNow();
      if (dark !== wasDark) {
        wasDark = dark;
        void renderMermaidDiagrams(true);
      }
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }
</script>
